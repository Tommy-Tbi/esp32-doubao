##
## 项目默认配置（非机密）。首次编译时 IDF 会用它生成 sdkconfig。
## 机密信息（WiFi 密码、Douyin APP_ID / ACCESS_KEY）请在
## `idf.py menuconfig` 中本地填写，sdkconfig 已被 .gitignore 排除。
## 也可以在设备上通过 Settings（app_id / access_key）运行时写入。
##
## 编译目标
CONFIG_IDF_TARGET="esp32s3"

## 板型：ESP-SPARKBOT
CONFIG_BOARD_TYPE_ESP_SPARKBOT=y

## Flash / 分区
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"

## 显示 / 资源
CONFIG_FLASH_DEFAULT_ASSETS=y
CONFIG_LANGUAGE_ZH_CN=y

## 音频
CONFIG_USE_AFE_WAKE_WORD=y
CONFIG_USE_AUDIO_PROCESSOR=y

## USB 音频：首次开机进入 OTG 音箱 + 麦克风模式，之后记住按键选择。
## 组合键或 BOOT 长按可与原生 Serial/JTAG 双向热切换，无需拔线/重启。
## 两种模式共用内部 PHY，不能同时使用。
CONFIG_USB_AUDIO_DEVICE=y
CONFIG_USB_AUDIO_SPEAKER=y
CONFIG_USB_AUDIO_MIC=y

## 网络配网：热点配网
CONFIG_USE_HOTSPOT_WIFI_PROVISIONING=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=y

## 摄像头（DVP）
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y

## 豆包（Douyin）实时语音：这里只开关，凭据留空由本地/运行时填写
CONFIG_DOUYIN_VOICE=y
CONFIG_DOUYIN_APP_ID=""
CONFIG_DOUYIN_ACCESS_KEY=""
