## Standalone ESP-SPARKBOT USB audio firmware (no voice assistant or network).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_TYPE_ESP_SPARKBOT=y

## Keep the existing flash layout/NVS addresses for upgrades.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"

## UI uses a built-in font; no downloaded assets or speech models are required.
CONFIG_FLASH_NONE_ASSETS=y
CONFIG_LANGUAGE_ZH_CN=y

## Native 48kHz / mono / 16-bit USB speaker + microphone.
## Chord or BOOT long press switches to/from native Serial/JTAG without reboot.
CONFIG_USB_AUDIO_DEVICE=y
CONFIG_USB_AUDIO_SPEAKER=y
CONFIG_USB_AUDIO_MIC=y
CONFIG_TINYUSB_NO_DEFAULT_TASK=y
CONFIG_TINYUSB_HID_ENABLED=y
CONFIG_TINYUSB_HID_COUNT=1

## UART1 logs stay available while OTG owns the internal USB PHY.
## UART0 GPIO43/44 are LCD DC/CS; UART1 GPIO38/48 is no longer used by a chassis.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=1
CONFIG_ESP_CONSOLE_UART_TX_GPIO=38
CONFIG_ESP_CONSOLE_UART_RX_GPIO=48
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
